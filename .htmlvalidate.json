{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "no-trailing-whitespace": "off",
    "attr-quotes": "off",
    "void-style": "off",
    "long-title": "off",
    "no-implicit-button-type": "error",
    "svg-focusable": "off",
    "attribute-boolean-style": "off",
    "prefer-tbody": "off",
    "no-redundant-role": "warn",
    "text-content": "off",
    "doctype-style": "off",
    "empty-heading": "off",
    "wcag/h30": "off",
    "unique-landmark": "off"
  }
}
